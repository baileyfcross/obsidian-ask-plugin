{
  "name": "local-vault-ai",
  "version": "0.2.2",
  "description": "Local RAG assistant for an Obsidian vault using Ollama and Orama.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
	"package": "bash ./scripts/package.sh",
    "deploy:test": "bash ./scripts/deploy-test.sh"
  },
  "keywords": [
    "obsidian",
    "ollama",
    "rag",
    "local-ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@orama/orama": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
